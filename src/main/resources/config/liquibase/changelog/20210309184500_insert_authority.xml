    <changeSet id="20210309184500-1" author="wojsam">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                select COUNT(1) from jhi_authority where name = 'ROLE_SYSTEM';
            </sqlCheck>
        </preConditions>

        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_SYSTEM"/>
        </insert>
    </changeSet>
