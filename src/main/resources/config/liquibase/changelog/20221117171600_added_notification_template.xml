<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <changeSet id="20221117171600-1" author="mwojsa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="NOTIFICATION_TEMPLATE"/>
            </not>
        </preConditions>
        <createTable tableName="NOTIFICATION_TEMPLATE">
            <column name="TYPE" type="varchar(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CONTENT" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20230301171600-2" author="mwojsa">
        <insert tableName="NOTIFICATION_TEMPLATE">
            <column name="TYPE" value="BIRTH_SMS"/>
            <column name="CONTENT" value="Z okazji urodzin życzę zdrowia, szczęścia i pomyślności. Miłosz Kiedrowski"/>
        </insert>
    </changeSet>

    <changeSet id="20230301171600-3" author="mwojsa">
        <update tableName="NOTIFICATION_TEMPLATE">
            <column name="TYPE" value="BIRTH_SMS"/>
            <column name="CONTENT" value="Z okazji urodzin życzę zdrowia, szczęścia i pomyślności. ePracownik"/>
        </update>
    </changeSet>

</databaseChangeLog>
